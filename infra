#!/usr/bin/env bash
eval "$(sops -d "$(dirname "$0")/secrets.sops.env" | sed 's/^/export /')"
export HCLOUD_TOKEN="$TF_VAR_hcloud_token"
export TRUSTED_SSH_CIDR="$TF_VAR_trusted_ssh_cidr"
export AWS_SHARED_CREDENTIALS_FILE=/dev/null
export AWS_CONFIG_FILE=/dev/null

case "$1" in
  tf)
    shift
    cd "$(dirname "$0")/terraform" || exit 1
    exec terraform "$@"
    ;;
  pb)
    shift
    cd "$(dirname "$0")/ansible" || exit 1
    exec ansible-playbook "$@"
    ;;
  *)
    echo "usage: $0 {tf|pb} [args...]" >&2
    exit 1
    ;;
esac
